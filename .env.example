# NanoAlign Environment Configuration Template
# Copy to .env before running scripts

# HuggingFace Token (Optional: for gated models or pushing checkpoints)
HF_TOKEN=hf_your_token_here

# W&B / Telemetry Tracking (Optional)
WANDB_API_KEY=your_wandb_api_key_here
WANDB_PROJECT=nano-align

# Execution Knobs
CUDA_VISIBLE_DEVICES=0
DEBUG=False
LOAD_CHECKPOINT=True
